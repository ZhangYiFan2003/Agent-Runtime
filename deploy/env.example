# Copy to deploy/.env and replace every CHANGE_ME value before startup.
POSTGRES_USER=axiom
POSTGRES_DB=axiom
POSTGRES_PASSWORD=CHANGE_ME
AXIOM_POSTGRES_DSN=postgresql://axiom:CHANGE_ME@postgres:5432/axiom
AXIOM_RUNTIME_API_KEY=CHANGE_ME
AXIOM_WEB_PORT=8080

# Default is an isolated Docker volume. Set an absolute dedicated host directory to bind it.
AXIOM_WORKSPACE_MOUNT=workspace_data

# Per-Run Docker shell sandbox resource limits.
AXIOM_SANDBOX_IMAGE=axiom-sandbox:local
# Keep axiom_workspace_data for the default named volume. For a bind mount, set this
# to the same absolute host path as AXIOM_WORKSPACE_MOUNT.
AXIOM_SANDBOX_WORKSPACE_SOURCE=axiom_workspace_data
AXIOM_SANDBOX_CPU_LIMIT=1.0
AXIOM_SANDBOX_MEMORY_LIMIT_BYTES=536870912
AXIOM_SANDBOX_PIDS_LIMIT=128
AXIOM_SANDBOX_TMPFS_SIZE_BYTES=67108864

# Optional provider configuration for real Agent Runs. Leave the key empty for deployment smoke.
AXIOM_PROVIDER=deepseek
AXIOM_MODEL=deepseek-v4-flash
AXIOM_API_KEY=
