    {"id":"plan_tool_success_gap","category":"plan","crash_window":"Child Tool SUCCEEDED before Child checkpoint","test":"tests/test_durable_plan_runtime.py::test_succeeded_tool_record_is_reused_across_plan_checkpoint_gap","expected_outcome":"recovered","assertions":["no_duplicate_tool","result_preserved","terminal_state_correct"]},
    {"id":"plan_waiting_approval","category":"plan","crash_window":"Plan Child WAITING_APPROVAL restart","test":"tests/test_durable_plan_runtime.py::test_plan_approval_survives_sqlite_restart_and_continues_same_step","expected_outcome":"recovered","assertions":["no_duplicate_tool","terminal_state_correct"]},
    {"id":"plan_replan_v2","category":"plan","crash_window":"v2 persisted then crash","test":"tests/test_durable_plan_parallelism.py::test_plan_replan_checkpoint_survives_crash_without_replanning_again","expected_outcome":"recovered","assertions":["no_duplicate_child","result_preserved","terminal_state_correct"]},
    {"id":"plan_identity_before_spawn","category":"plan","crash_window":"Child identity persisted before spawn","test":"tests/test_durable_plan_parallelism.py::test_plan_child_identities_are_persisted_before_any_spawn","expected_outcome":"recovered","assertions":["no_duplicate_child","terminal_state_correct"]},
