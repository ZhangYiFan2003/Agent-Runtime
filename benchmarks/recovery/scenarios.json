    {"id":"react_tool_success_gap","category":"react","crash_window":"Tool SUCCEEDED before parent checkpoint","test":"tests/test_durable_runtime.py::test_success_record_deduplicates_tool_when_state_checkpoint_was_not_written","expected_outcome":"recovered","assertions":["no_duplicate_tool","result_preserved","terminal_state_correct"]},
    {"id":"react_waiting_approval","category":"react","crash_window":"restart while WAITING_APPROVAL","test":"tests/test_durable_runtime.py::test_tool_approval_interrupt_survives_sqlite_restart","expected_outcome":"recovered","assertions":["no_duplicate_tool","terminal_state_correct"]},
    {"id":"react_rejection_continuation","category":"react","crash_window":"approval decision before continuation","test":"tests/test_durable_runtime.py::test_rejected_tool_is_not_executed_and_rejection_reaches_agent","expected_outcome":"recovered","assertions":["no_duplicate_tool","result_preserved","terminal_state_correct"]},
    {"id":"react_manual_interrupt","category":"react","crash_window":"persisted interrupt before continuation","test":"tests/test_durable_runtime.py::test_manual_interrupt_can_resume_from_persisted_checkpoint","expected_outcome":"recovered","assertions":["result_preserved","terminal_state_correct"]},
    {"id":"react_ambiguous_running","category":"react","crash_window":"external side effect after RUNNING before SUCCEEDED","test":"tests/test_durable_runtime.py::test_ambiguous_side_effect_waits_for_explicit_recovery_decision","expected_outcome":"expected-safe","assertions":["no_duplicate_tool","terminal_state_correct"]},
