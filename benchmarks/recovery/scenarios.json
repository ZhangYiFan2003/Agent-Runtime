    {"id":"plan_before_checkpoint","category":"plan","crash_window":"before Plan completion checkpoint","test":"tests/test_durable_plan_runtime.py::test_crash_before_plan_checkpoint_repeats_planning_safely","expected_outcome":"recovered","assertions":["terminal_state_correct"]},
