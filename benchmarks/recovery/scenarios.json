    {"id":"react_run_checkpoint","category":"react","crash_window":"after Run creation checkpoint","test":"tests/test_durable_runtime.py::test_sqlite_store_reloads_latest_checkpoint_in_new_instance","expected_outcome":"recovered","assertions":["result_preserved","terminal_state_correct"]},
