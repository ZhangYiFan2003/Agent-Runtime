    {"id":"multi_identity_before_spawn","category":"multi-agent","crash_window":"Worker identity persisted before spawn","test":"tests/test_durable_multi_agent_runtime.py::test_stable_child_identity_survives_crash_before_child_creation","expected_outcome":"recovered","assertions":["no_duplicate_child","terminal_state_correct"]},
    {"id":"multi_terminal_unobserved","category":"multi-agent","crash_window":"terminal Worker not yet observed by Parent","test":"tests/test_durable_multi_agent_runtime.py::test_child_completion_is_reused_when_parent_has_not_observed_it","expected_outcome":"recovered","assertions":["no_duplicate_child","result_preserved","terminal_state_correct"]},
