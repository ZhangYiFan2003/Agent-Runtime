    {"id":"multi_parent_cancel","category":"multi-agent","crash_window":"Parent cancellation with active Child","test":"tests/test_durable_multi_agent_runtime.py::test_parent_cancel_cancels_waiting_child_and_stops_scheduling","expected_outcome":"recovered","assertions":["no_duplicate_tool","no_duplicate_child","terminal_state_correct"]},
    {"id":"multi_mixed_restart","category":"multi-agent","crash_window":"multiple concurrent Child terminal observation","test":"tests/test_durable_multi_agent_parallelism.py::test_mixed_state_restart_reconciles_without_duplicate_children","expected_outcome":"recovered","assertions":["no_duplicate_child","result_preserved","terminal_state_correct"]}
