{
  "schema_version": 1,
  "name": "agent-runtime-fixed-tasks",
  "version": "1.0.0",
  "metadata": {"scope":"Repository-grounded read-only tasks; real provider required for Task Success Rate."},
  "cases": [
    {"id":"basic_exact","prompt":"Respond with exactly AXIOM_EVAL_OK and nothing else. Do not use tools.","tags":["basic"],"scorers":[{"type":"run_status"},{"type":"exact_match","expected":"AXIOM_EVAL_OK"},{"type":"tool_usage","forbidden_tools":["write_file","bash","execute_command"]},{"type":"metric_threshold","max_tool_calls":0,"max_steps":4}]},
    {"id":"basic_no_tool","prompt":"In one sentence, state that Axiom is an Agent Runtime. Do not use tools.","tags":["basic"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["Agent","Runtime"]},{"type":"tool_usage","forbidden_tools":["write_file","bash","execute_command"]}]},
    {"id":"list_runtime","prompt":"Use list_dir on src/axiom/runtime and name durable.py and api.py.","tags":["tool-selection"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["durable.py","api.py"]},{"type":"tool_usage","required_tools":["list_dir"],"forbidden_tools":["write_file","bash"]}]},
    {"id":"read_checkpoint","prompt":"Use read_file on src/axiom/runtime/checkpoints.py and name both checkpoint store implementations.","tags":["tool-selection","durable"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["MemoryCheckpointStore","SQLiteCheckpointStore"]},{"type":"tool_usage","required_tools":["read_file"],"forbidden_tools":["write_file","bash"]}]},
    {"id":"grep_runtime","prompt":"Use grep to locate DurableAgentRuntime and report its source path.","tags":["tool-selection"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["runtime","durable.py"]},{"type":"tool_usage","required_tools":["grep"],"forbidden_tools":["write_file","bash"]}]},
    {"id":"search_code_runtime","prompt":"Use search_code to locate LocalPlanTaskScheduler and report its file.","tags":["tool-selection","code-search","plan"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["plan_strategy.py","LocalPlanTaskScheduler"]},{"type":"tool_usage","required_tools":["search_code"],"forbidden_tools":["write_file","bash"]}]},
    {"id":"find_symbol_context","prompt":"Use find_symbol for CodeContextBuilder and report its path.","tags":["tool-selection","symbol"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["context.py","CodeContextBuilder"]},{"type":"tool_usage","required_tools":["find_symbol"],"forbidden_tools":["write_file","bash"]}]},
    {"id":"search_read_llm","prompt":"Search for llm_client.chat in durable Runtime, read the relevant file, and name the method that collects the response.","tags":["multi-step","runtime"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["_collect_llm_response","durable.py"]},{"type":"tool_usage","required_tools":["read_file"],"forbidden_tools":["write_file","bash"]}]},
    {"id":"failed_read_recover","prompt":"First read src/axiom/runtime/missing.py, then recover by listing src/axiom/runtime and name an existing file.","tags":["multi-step","failure-handling"],"scorers":[{"type":"run_status"},{"type":"contains","expected":".py"},{"type":"tool_usage","required_tools":["read_file","list_dir"],"forbidden_tools":["write_file","bash"]}]},
    {"id":"multiple_files","prompt":"Inspect runtime/models.py and runtime/checkpoints.py; explain how Checkpoint and SQLiteCheckpointStore relate.","tags":["multi-step","durable"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["Checkpoint","SQLiteCheckpointStore"]},{"type":"tool_usage","required_tools":["read_file"],"forbidden_tools":["write_file","bash"]}]},
    {"id":"checkpoint_semantics","prompt":"Read docs/durable-execution.md and explain what a checkpoint preserves.","tags":["durable"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["Checkpoint","resume"]},{"type":"tool_usage","required_tools":["read_file"],"forbidden_tools":["write_file","bash"]}]},
    {"id":"exactly_once_boundary","prompt":"Read docs/durable-execution.md and explain the exactly-once boundary using invocation_id.","tags":["durable"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["invocation_id","exactly-once"]},{"type":"tool_usage","required_tools":["read_file"],"forbidden_tools":["write_file","bash"]}]},
    {"id":"permission_policy","prompt":"Inspect permissions.py and name Capability, PermissionRequest, and DefaultPermissionPolicy.","tags":["permission"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["Capability","PermissionRequest","DefaultPermissionPolicy"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"read_allowed","prompt":"Read src/axiom/policy/path_guard.py and identify PathGuard. Do not modify anything.","tags":["permission"],"scorers":[{"type":"run_status"},{"type":"contains","expected":"PathGuard"},{"type":"tool_usage","required_tools":["read_file"],"forbidden_tools":["write_file","bash"]}]},
    {"id":"write_forbidden","prompt":"Explain which built-in tool writes files, but do not call it or modify the repository.","tags":["permission"],"scorers":[{"type":"run_status"},{"type":"contains","expected":"write_file"},{"type":"tool_usage","forbidden_tools":["write_file","bash","execute_command"]}]},
    {"id":"plan_dag","prompt":"Inspect plan/models.py and explain how Task dependencies form an ExecutionPlan DAG.","tags":["plan"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["Task","ExecutionPlan","dependencies"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"plan_scheduler","prompt":"Locate the bounded Plan scheduler and name LocalPlanTaskScheduler and max_parallel_tasks.","tags":["plan"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["LocalPlanTaskScheduler","max_parallel_tasks"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"plan_child_identity","prompt":"Inspect plan_strategy.py and report the stable Plan child identity function.","tags":["plan","durable"],"scorers":[{"type":"run_status"},{"type":"contains","expected":"plan_task_child_run_id"},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"multi_assignments","prompt":"Inspect multi_agent_strategy.py and explain WorkerAssignment and child_run_id.","tags":["multi-agent"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["WorkerAssignment","child_run_id"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"multi_scheduler","prompt":"Name the bounded Multi-Agent scheduler and its parallel worker setting.","tags":["multi-agent"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["LocalChildRunScheduler","max_parallel_workers"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"multi_synthesis","prompt":"Inspect how Multi-Agent final results are synthesized and name _build_final_result.","tags":["multi-agent"],"scorers":[{"type":"run_status"},{"type":"contains","expected":"_build_final_result"},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"runtime_api","prompt":"Locate the Runtime HTTP API server class and the /v1/runs route implementation.","tags":["runtime","api"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["RuntimeApiServer","/v1/runs"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"trace_span","prompt":"Inspect observability.py and explain Trace, Span, and RunMetrics.","tags":["runtime","observability"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["Trace","Span","RunMetrics"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"run_turn_event","prompt":"Explain Thread, Turn, Run, and Event using runtime source or docs.","tags":["runtime"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["Thread","Turn","Run","Event"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"control_plane","prompt":"Inspect control_plane.py and name allowed_operations, run_view, and recovery_action.","tags":["runtime","control-plane"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["allowed_operations","run_view","recovery_action"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"run_metrics_route","prompt":"Find the HTTP route that returns Run metrics and report the route suffix and file.","tags":["runtime","api"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["/metrics","api.py"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"evaluation_scorers","prompt":"Inspect evaluation/scorers.py and list the five built-in deterministic scorer classes.","tags":["evaluation"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["ContainsScorer","ExactMatchScorer","RunStatusScorer","ToolUsageScorer","MetricThresholdScorer"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"evaluation_runner","prompt":"Explain how DurableEvaluationExecutor records tool calls, tokens, and steps.","tags":["evaluation","runtime"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["DurableEvaluationExecutor","tool","tokens","steps"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"code_index_modes","prompt":"Inspect CodeIndex.search and name lexical, vector, hybrid, and auto modes.","tags":["code-search"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["lexical","vector","hybrid","auto"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"rrf","prompt":"Locate reciprocal_rank_fusion and explain that hybrid combines ranks.","tags":["code-search"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["reciprocal_rank_fusion","rank"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"graph_context","prompt":"Inspect context.py and list search_seed, caller, and callee reasons.","tags":["code-search"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["search_seed","caller","callee"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"memory_service","prompt":"Locate MemoryService and MemoryStore and report both files.","tags":["memory"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["service.py","store.py"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"memory_context","prompt":"Inspect MemoryContextBuilder and explain its token budget behavior.","tags":["memory"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["MemoryContextBuilder","token"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"memory_facts","prompt":"Inspect DeterministicFactExtractor and explain sensitive fact rejection.","tags":["memory","security"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["DeterministicFactExtractor","sensitive"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"mcp_client","prompt":"Inspect MCP client code and name McpClientManager and the two supported client transports.","tags":["mcp"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["McpClientManager","stdio","streamable"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"mcp_server","prompt":"Inspect MCP server code and name serve_stdio and serve_http.","tags":["mcp"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["serve_stdio","serve_http"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"restricted_backend","prompt":"Inspect execution/backends.py and explain RestrictedExecutionBackend and filtered_host_environment.","tags":["security","runtime"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["RestrictedExecutionBackend","filtered_host_environment"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"tool_concurrency_boundary","prompt":"Read benchmarks/README.md and state what the Tool concurrency benchmark measures and excludes.","tags":["evaluation","tool-concurrency"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["ToolExecutor.execute_all","LLM"]},{"type":"tool_usage","required_tools":["read_file"],"forbidden_tools":["write_file","bash"]}]},
    {"id":"sse_replay","prompt":"Inspect Runtime API event handling and explain after_event_id replay.","tags":["runtime","api"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["after_event_id","replay"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]},
    {"id":"artifact_schema","prompt":"Inspect evaluation/models.py and name EvaluationSuiteResult and EvaluationRunResult.","tags":["evaluation"],"scorers":[{"type":"run_status"},{"type":"contains","expected":["EvaluationSuiteResult","EvaluationRunResult"]},{"type":"tool_usage","forbidden_tools":["write_file","bash"]}]}
  ]
}
